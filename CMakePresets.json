{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Dev (core + tests, no dependencies)",
            "generator": "Visual Studio 18 2026",
            "architecture": { "value": "x64", "strategy": "set" },
            "binaryDir": "${sourceDir}/build/dev"
        },
        {
            "name": "avoid",
            "displayName": "Dev + libavoid backend (fetches adaptagrams)",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/libavoid",
            "cacheVariables": { "GRAPHER_AVOID": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "debug",         "configurePreset": "dev",   "configuration": "Debug" },
        { "name": "release",       "configurePreset": "dev",   "configuration": "RelWithDebInfo" },
        { "name": "avoid-debug",   "configurePreset": "avoid", "configuration": "Debug" },
        { "name": "avoid-release", "configurePreset": "avoid", "configuration": "RelWithDebInfo" }
    ],
    "testPresets": [
        { "name": "debug",       "configurePreset": "dev",   "configuration": "Debug", "output": { "outputOnFailure": true } },
        { "name": "avoid-debug", "configurePreset": "avoid", "configuration": "Debug", "output": { "outputOnFailure": true } }
    ]
}
