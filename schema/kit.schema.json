        },
        "labelScale": {
          "type": "number"
        }
      }
    },
    "rule": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select"
          ],
          "description": "Patches a pin kind (> pin:<kind>).",
          "properties": {
            "select": {
              "type": "string",
              "description": "kind? ([tag])* (:state)* (> part)?: a kind may hold ':' and end in '*' (a prefix); states: selected, hovered, dimmed, alias, collapsed, inGroup, wired, unwired, lit, merged; a part may be pin:<kind>, row:<kind> or edge:<kind>.",
              "pattern": ">\\s*pin:"
            },
            "glyph": {
              "type": "string",
              "enum": [
                "circle",
                "square",
                "diamond",
                "arrow"
