            "select"
          ],
          "description": "Patches the card, or the part it names (> <id>).",
          "properties": {
            "select": {
              "type": "string",
              "description": "kind? ([tag])* (:state)* (> part)?: a kind may hold ':' and end in '*' (a prefix); states: selected, hovered, dimmed, alias, collapsed, inGroup, wired, unwired, lit, merged; a part may be pin:<kind>, row:<kind> or edge:<kind>.",
              "pattern": "^(?!.*>\\s*(pin|row|edge):)"
            },
            "visible": {
              "type": "boolean"
            },
            "fill": {
              "type": "string",
              "description": "A colour expression: #rrggbb[aa], $token, band, none, lighter(c, n), darker(c, n), alpha(c, a), palette(name, tag:key)."
            },
            "stroke": {
              "type": "string",
              "description": "A colour expression: #rrggbb[aa], $token, band, none, lighter(c, n), darker(c, n), alpha(c, a), palette(name, tag:key)."
            },
            "color": {
              "type": "string",
              "description": "A colour expression: #rrggbb[aa], $token, band, none, lighter(c, n), darker(c, n), alpha(c, a), palette(name, tag:key)."
            },
            "strokeWidth": {
              "type": "number"
            },
            "corner": {
              "type": "number"
            },
            "opacity": {
              "type": "number"
            },
            "dash": {
              "type": "boolean"
            },
            "width": {
              "type": "number"
            },
            "top": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "from": {
              "type": "string",
              "description": "field:<id>, row:<id>, type, fields, fields:all"
            },
            "placeholder": {
              "type": "string"
            },
            "placeholderColor": {
              "type": "string",
              "description": "A colour expression: #rrggbb[aa], $token, band, none, lighter(c, n), darker(c, n), alpha(c, a), palette(name, tag:key)."
            },
            "font": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            },
            "box": {
              "type": "number"
            },
            "advance": {
              "type": "number"
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "if": {
              "type": "string",
              "description": "kind? ([tag])* (:state)* (> part)?: a kind may hold ':' and end in '*' (a prefix); states: selected, hovered, dimmed, alias, collapsed, inGroup, wired, unwired, lit, merged; a part may be pin:<kind>, row:<kind> or edge:<kind>."
            },
            "editor": {
              "type": "string"
            },
            "shape": {
              "type": "string",
              "enum": [
                "box",
                "pill",
                "circle",
                "octagon"
              ],
              "description": "A card root's when its group is closed (box, pill); a rim's (circle, octagon)."
            },
            "format": {
              "type": "string",
              "description": "A text's template: {value} {type} {count} {arrow} {fields}."
            },
            "pin": {
              "type": "string"
            },
            "glyph": {
              "type": "string",
              "enum": [
                "circle",
                "square",
                "diamond",
                "arrow"
              ]
            },
            "hollow": {
              "type": "boolean"
            },
            "side": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "length": {
              "type": "number"
            },
            "direction": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            },
            "band": {
              "type": "string",
              "description": "A colour expression: #rrggbb[aa], $token, band, none, lighter(c, n), darker(c, n), alpha(c, a), palette(name, tag:key)."
            },
            "chamfer": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "An octagon rim's corner cut, a fraction of its half-width."
            },
            "on": {
              "type": "object",
              "description": "Gesture -> action id (a host command, or `edit`).",
              "propertyNames": {
                "enum": [
                  "click",
                  "doubleClick",
                  "contextMenu",
                  "dragToNothing"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
