              "type": "string"
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "valueAlign": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "chip": {
              "type": "boolean"
            },
            "editor": {
              "type": "string",
